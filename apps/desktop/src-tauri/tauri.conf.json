{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatAgent",
  "version": "0.1.0",
  "identifier": "com.chatagent.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChatAgent",
        "width": 1080,
        "height": 700,
        "minWidth": 860,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
